HOST=0.0.0.0
PORT=8000
JWT_SECRET=your_jwt_secret_here

DATABASE_URL=postgresql://user:password@localhost:5432/mydatabase
DATABASE_SCALE_0=false  # set `true` if your db will scale to 0 when idle, this will disable listen to pgsql notifications and enable pool_pre_ping

LLM_SP_AK=your_llm_sp_ak_here
LLM_SP_BASE_URL=https://api.your-llm-provider.com/openapi/v1

LOGTAIL_SOURCE_TOKEN=your_token_here
LOGTAIL_HOST=https://in.logtail.com