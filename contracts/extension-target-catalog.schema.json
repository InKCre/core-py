{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InKCre admitted extension target catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "name",
          "version",
          "target_key",
          "target_digest",
          "extension_id",
          "bundle_path",
          "manifest_path"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*))(?:\\.(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?$"
          },
          "target_key": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
          },
          "target_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "extension_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "bundle_path": {
            "type": "string",
            "pattern": "^/app/extension-targets/[a-z][a-z0-9_]{0,63}/bundle\\.zip$"
          },
          "manifest_path": {
            "type": "string",
            "pattern": "^/app/extension-targets/[a-z][a-z0-9_]{0,63}/manifest\\.json$"
          }
        }
      }
    }
  }
}
